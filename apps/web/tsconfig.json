{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "composite": true,
    "rootDir": ".",
    "outDir": "dist-types"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
